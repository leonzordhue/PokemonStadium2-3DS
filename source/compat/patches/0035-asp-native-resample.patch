+        }
+        for (int i = 0; i < 8; i++) { rsp.vpu.r[16].s16(i) = (int16_t)cur[i]; rsp.vpu.r[14].s16(i) = (int16_t)y[i]; }
+        rsp.VXOR<0>(rsp.vpu.r[0], rsp.vpu.r[0], rsp.vpu.r[0]);
+        rsp.VADDC<0>(rsp.vpu.r[15], rsp.vpu.r[0], rsp.vpu.r[16]);   // v15 and VCO as the last pass leaves them
