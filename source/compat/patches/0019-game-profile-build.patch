--- /dev/null
+++ b/compat/trace.h
@@ -0,0 +1,26 @@
+// s2-3ds (Nexus D25): included by the generated game code when game.toml has trace_mode = true.
+// TRACE_ENTRY at each function start, TRACE_RETURN before each return (n64recomp-fork recompilation.cpp).
+// Off (default): both empty, so the code is the same as a build without trace_mode.
+// S2_GAME_PROFILE=ON (CMake): name the running function for rt64-3ds's sampling profile
+// (settings.ini dbg_profile=2; game_profile.cpp reads recomp3ds_trace_func). Same scheme as
+// BanjoRecomp3D/platform/3ds/trace.h, without its preemption check. Costs ~8% size and speed: measure only.
+#ifndef S2_TRACE_H
+#define S2_TRACE_H
+#ifdef S2_GAME_PROFILE
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern const char* volatile recomp3ds_trace_func;   // defined in rt64-3ds game_profile.cpp
+#ifdef __cplusplus
+}
+#endif
+#define TRACE_ENTRY() \
+    const char* const trace_prev_ = recomp3ds_trace_func; \
+    recomp3ds_trace_func = __func__;
+#define TRACE_RETURN() \
+    recomp3ds_trace_func = trace_prev_;
+#else
+#define TRACE_ENTRY()
+#define TRACE_RETURN()
+#endif
+#endif
