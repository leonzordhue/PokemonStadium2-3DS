     void retire_rtt_targets() {
+        // D36c (nexus): with kMaxRtt 8 the menus' images (four 128x512
+        // labels, 512 KB each) stay alive into the battle, where round robin
+        // over 4 slots used to replace them. When a target failed for VRAM,
+        // the least recently used one idle for kRttIdle frames goes, one per
+        // frame (the labels first; the portraits, sampled every frame, stay).
+        // Never without a failure: freeing idle targets always blacked out
+        // the portraits on the console (D50).
+        if (rtt_pressure_) {
+            rtt_pressure_ = false;
+            static constexpr uint32_t kRttIdle = 90;
+            int lru = -1;
+            for (int i = 0; i < rt64_3ds::kMaxRtt; i++) {
+                const RttTarget& t = rtt_[i];
+                if (t.rt == nullptr || frames_ - t.used_frame < kRttIdle) continue;
+                if (lru < 0 || t.used_frame < rtt_[lru].used_frame) lru = i;
+            }
+            if (lru >= 0) {
+                RttTarget& t = rtt_[lru];
+                retired_rtt_.push_back({ t.rt, t.tex });
+                t.rt = nullptr; t.w = t.h = 0;
