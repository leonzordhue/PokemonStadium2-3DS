@@ -156,6 +156,27 @@
 // D27 (nexus): the game thread sat in func_80013B54 (loop 0x80013B74..0x80013C38)
 // at the Rental -> battle load. Print the table it walks: D_8011BE90 +0x29AC ptr,
 // +0x29B0 total, +0x29B4 count, +0x2BBE/F next slots. A huge count = corrupted.
+// D27b (nexus): who turns the count at 0x8011E844 into 0xFFFFxxxx. Polls the word
+// every ~1 ms and prints each change with the game's last loop pc; the RSP DMA
+// side prints in rsp.hpp (S2 D27 rsp-dma). shortcut: diagnosis only, remove with the fix.
+volatile bool g_d27_run = true;
+void s2_d27_watch(void*) {
+    uint32_t last = 0, prints = 0;
+    while (g_d27_run && prints < 48) {
+        if (g_s2_rdram) {
+            const uint32_t v = *reinterpret_cast<volatile uint32_t*>(g_s2_rdram + 0x11E844u);
+            if (v != last) {
+                fprintf(stderr, "[S2] D27 watch 8011E844 %08lX -> %08lX loop pc %08lX t %llu ms\n",
+                        (unsigned long)last, (unsigned long)v, (unsigned long)s2_last_loop_pc,
+                        (unsigned long long)(svcGetSystemTick() / (SYSCLOCK_ARM11 / 1000)));
+                last = v;
+                prints++;
+            }
+        }
+        svcSleepThread(1000000LL);
+    }
+}
+
 void s2_dump_80013B54() {
     if (!g_s2_rdram) return;
     auto w = [](uint32_t va) { return *reinterpret_cast<uint32_t*>(g_s2_rdram + (va - 0x80000000u)); };
