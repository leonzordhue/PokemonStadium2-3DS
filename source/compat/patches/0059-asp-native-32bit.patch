+// P48: 4 halfwords from any DMEM byte address (the RESAMPLE input is often odd): 3 host words
+// (each = one big-endian N64 word) and a shift, instead of 8 masked byte loads. Near the end of
+// DMEM (the read would wrap) it goes halfword by halfword.
+static inline void s2_ld4(uint32_t a, int32_t* v) {
+    a &= 0xFFF;
+    if (a > 0xFF4) { for (int k = 0; k < 4; k++) v[k] = s2_dh(a + 2 * k); return; }
+    const uint32_t b = a & ~3u, sh = (a & 3) * 8;
+    uint32_t w0, w1, w2;
+    memcpy(&w0, dmem + b, 4); memcpy(&w1, dmem + b + 4, 4); memcpy(&w2, dmem + b + 8, 4);
+    uint64_t x = ((uint64_t)w0 << 32) | w1;
+    if (sh) x = (x << sh) | (w2 >> (32 - sh));
+    v[0] = (int16_t)(x >> 48); v[1] = (int16_t)(x >> 32); v[2] = (int16_t)(x >> 16); v[3] = (int16_t)x;
+}
