@@ -6,6 +6,33 @@
 #include "ultramodern/ultra64.h"
 #include "ultramodern/ultramodern.hpp"
 
+#ifdef S2_QUEUE_WAIT
+// D28 (s2-3ds): how long game threads stay blocked in osRecvMesg, per queue,
+// printed once a second. Finds the message the frame manager waits on last.
+#include <chrono>
+#include <cstdio>
+namespace {
+struct QWait { uint32_t mq; uint32_t thread; uint64_t us; uint32_t n; };
+QWait s2_qwait[16];
+std::chrono::steady_clock::time_point s2_qwait_t0 = std::chrono::steady_clock::now();
+void s2_qwait_note(uint32_t mq, uint32_t thread, uint64_t us) {
+    for (QWait& q : s2_qwait) {
+        if (q.n == 0 && q.mq == 0) { q.mq = mq; q.thread = thread; }
+        if (q.mq == mq && q.thread == thread) { q.us += us; q.n++; break; }
+    }
+    auto now = std::chrono::steady_clock::now();
+    if (now - s2_qwait_t0 < std::chrono::seconds(1)) return;
+    s2_qwait_t0 = now;
+    fprintf(stderr, "qwait:");
+    for (QWait& q : s2_qwait) {
+        if (q.n != 0) fprintf(stderr, " t%u %08X %llums/%u", (unsigned)q.thread, (unsigned)q.mq, (unsigned long long)(q.us / 1000), (unsigned)q.n);
+        q.us = 0; q.n = 0;
+    }
+    fprintf(stderr, "\n");
+}
+}
+#endif
+
 struct QueuedMessage {
     PTR(OSMesgQueue) mq;
     OSMesg mesg;
