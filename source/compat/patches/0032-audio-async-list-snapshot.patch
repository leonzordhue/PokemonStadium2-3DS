+// s2-3ds P36: an asynchronous audio task runs after the game was told it had
+// completed, and the game may have rebuilt its command list meanwhile. The
+// task thread points these at the list as it was when the task was submitted
+// (physical base, size, the RDRAM bytes as stored); DMA reads inside it come
+// from that copy. size 0 = off. Defined in ultramodern events.cpp.
+extern "C" uint32_t s2_alist_base, s2_alist_size;
+extern "C" const uint8_t* s2_alist_bytes;
 static inline void dma_rdram_to_dmem(uint8_t* rdram, uint32_t dmem_addr, uint32_t dram_addr, uint32_t rd_len) {
     const uint32_t block_len = rsp_dma_block_len(rd_len);
     const uint32_t count = rsp_dma_count(rd_len);
@@ -165,7 +172,9 @@
     uint32_t cur_dram = dram_addr & 0xFFFFF8u;
     for (uint32_t block = 0; block <= count; block++) {
         for (uint32_t i = 0; i < block_len; i++) {
-            RSP_MEM_B(i, cur_dmem) = MEM_B(0, (int64_t)(int32_t)(cur_dram + i + 0x80000000));
+            const uint32_t s2_off = cur_dram + i - s2_alist_base;
+            if (s2_off < s2_alist_size) RSP_MEM_B(i, cur_dmem) = (int8_t)s2_alist_bytes[s2_off ^ 3];
+            else RSP_MEM_B(i, cur_dmem) = MEM_B(0, (int64_t)(int32_t)(cur_dram + i + 0x80000000));
         }
         cur_dmem = (cur_dmem + block_len) & 0x0FFFu;
         cur_dram = (cur_dram + block_len + (block != count ? skip : 0u)) & 0xFFFFF8u;
