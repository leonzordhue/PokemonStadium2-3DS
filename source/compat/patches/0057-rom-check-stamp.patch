+#ifdef __3DS__
+extern "C" int32_t archive_getmtime(const char* name, uint64_t* mtime);   // libctru 3ds/archive.h
+
+// P46 (proton): the full hash reads the whole ROM from the SD card (64 MB,
+// ~10 s on the console). A ROM that passed once leaves a stamp beside it
+// (size, mtime, the header's CRC1/CRC2 and the expected hash); the next boots
+// trust a ROM whose stamp still matches and skip the read.
+static std::string rom_stamp(const std::filesystem::path& path, uint64_t expected_hash) {
+    std::ifstream file{ path, std::ios::binary };
+    if (!file.good()) {
+        return {};
+    }
+    file.seekg(0, std::ios::end);
+    const uint64_t size = (uint64_t)file.tellg();
+    unsigned char crc[8] = {};
+    file.seekg(0x10, std::ios::beg);
+    file.read(reinterpret_cast<char*>(crc), sizeof(crc));
+    if (file.gcount() != (std::streamsize)sizeof(crc)) {
+        return {};
+    }
+    uint64_t mtime = 0;
+    archive_getmtime(path.string().c_str(), &mtime);
+    char stamp[128];
+    snprintf(stamp, sizeof(stamp), "%016llx %llx %llx %02x%02x%02x%02x%02x%02x%02x%02x", (unsigned long long)expected_hash,
+             (unsigned long long)size, (unsigned long long)mtime, crc[0], crc[1], crc[2], crc[3], crc[4], crc[5], crc[6], crc[7]);
+    return stamp;
+}
+#endif
