 bool check_stored_rom(const recomp::GameEntry& game_entry) {
+#ifdef __3DS__
+    const std::filesystem::path rom_path = config_path / game_entry.stored_filename();
+    std::filesystem::path ok_path = rom_path;
+    ok_path += ".ok";
+    const std::string stamp = rom_stamp(rom_path, game_entry.rom_hash);
+    if (!stamp.empty()) {
+        std::ifstream ok_file{ ok_path };
+        std::string saved;
+        std::getline(ok_file, saved);
+        if (saved == stamp) {
+            fprintf(stderr, "recomp3ds: ROM check: stamp matches (%s), full hash skipped\n", ok_path.string().c_str());
+            return true;
+        }
+    }
+    fprintf(stderr, "recomp3ds: ROM check: hashing the whole ROM (first boot or ROM changed)\n");
+#endif
