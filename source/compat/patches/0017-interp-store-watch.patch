 // divergence — don't guess.
 static const bool g_interp_trace = std::getenv("PSR_INTERP_TRACE") != nullptr;
 
+// s2-3ds (Nexus D19b): store watchpoint. In test 214407 thread 7's OSThread (0x80126530) got id 0x8000003A
+// right after interpreted 0xEF code ran, and the scheduler lost the thread. Logs the first stores into
+// [g_s2_watch_lo, g_s2_watch_hi) with the PC; set both to 0 to turn it off.
+uint32_t g_s2_watch_lo = 0x80126530u, g_s2_watch_hi = 0x80126530u + 0x1B0u;
+int g_s2_watch_left = 16;
+inline void s2_watch(uint32_t addr, uint32_t size, uint32_t pc, uint32_t insn) {
+    if (g_s2_watch_left > 0 && addr < g_s2_watch_hi && addr + size > g_s2_watch_lo) {
+        g_s2_watch_left--;
+        std::fprintf(stderr, "[interp] WATCH store 0x%08X (+%u) at PC 0x%08X insn 0x%08X\n", addr, size, pc, insn);
+    }
+}
