+// P39 [Proton]: DMEM halfword access for the native loops. DMEM bytes are stored word-swapped (byte x at
+// dmem[x ^ 3]), so an even halfword is one host u16 at (x ^ 2); odd addresses go byte by byte (LDV/SQV order).
+static inline int32_t s2_dh(uint32_t a) {
+    a &= 0xFFF;
+    if (!(a & 1)) { uint16_t v; memcpy(&v, dmem + (a ^ 2), 2); return (int16_t)v; }
+    return (int16_t)((dmem[a ^ 3] << 8) | dmem[((a + 1) & 0xFFF) ^ 3]);
+}
+// Stores n bytes (n even) of the halfwords v[] from DMEM address a, in order, wrapping at 4 KB.
+template <typename T> static inline void s2_st(uint32_t a, const T* v, uint32_t n) {
+    if (!(a & 1)) {
+        for (uint32_t i = 0; i < n / 2; i++) { const uint16_t h = (uint16_t)v[i]; memcpy(dmem + (((a + 2 * i) & 0xFFF) ^ 2), &h, 2); }
+        return;
+    }
+    for (uint32_t b = 0; b < n; b++) RSP_MEM_BU(0, a + b) = (uint8_t)(b & 1 ? v[b >> 1] : v[b >> 1] >> 8);
+}
+// P39: 8 halfwords at a 4-byte aligned address that does not wrap: host word k = N64 word (elements 2k, 2k+1).
+static inline void s2_ld8(uint32_t a, int32_t* v) {
+    a &= 0xFFF;
+    if ((a & 3) || a > 0xFF0) { for (int i = 0; i < 8; i++) v[i] = s2_dh(a + 2 * i); return; }
+    for (int k = 0; k < 4; k++) { uint32_t w; memcpy(&w, dmem + a + 4 * k, 4); v[2 * k] = (int16_t)(w >> 16); v[2 * k + 1] = (int16_t)w; }
+}
+template <typename T> static inline void s2_st8(uint32_t a, const T* v) {
+    a &= 0xFFF;
+    if ((a & 3) || a > 0xFF0) { s2_st(a, v, 16); return; }
+    for (int k = 0; k < 4; k++) { const uint32_t w = ((uint32_t)(uint16_t)v[2 * k] << 16) | (uint16_t)v[2 * k + 1]; memcpy(dmem + a + 4 * k, &w, 4); }
+}
+#endif
